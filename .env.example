# Network identity
SERVER_IP=192.168.1.100
DB_HOST=ragnarok-db
DB_PORT=3306

# MariaDB: the root and game-account credentials below are used on first initialization.
# Password changes in this file do not rotate credentials in an existing database volume.
MARIADB_ROOT_PASSWORD=replace_with_a_unique_root_secret

# Game database credentials
RAGNAROK_DB_NAME=ragnarok
RAGNAROK_LOG_DB_NAME=ragnarok_logs
RAGNAROK_DB_USER=ragnarok
RAGNAROK_DB_PASSWORD=replace_with_a_unique_game_secret

# FluxCP
FLUXCP_PORT=8080
SITE_TITLE=Local Ragnarok
FLUX_INSTALLER_PASSWORD=CHANGE_ME_TO_ANOTHER_UNIQUE_PASSWORD

# Persistent storage on Unraid
APPDATA_ROOT=/mnt/user/appdata/ragnarok

# Client compatibility is determined by the rAthena image build.
# Image source refs are selected in the GitHub Actions build workflows;
# these environment settings do not change already-built/published images.

# Import upstream SQL schemas only when each target database contains zero tables.
# Set false to manage schema imports manually.
AUTO_IMPORT_SQL=true

# Ollama is optional. The supervisor profile is disabled unless explicitly selected.
OLLAMA_URL=http://YOUR_OLLAMA_HOST:11434
OLLAMA_MODEL=qwen3:4b
